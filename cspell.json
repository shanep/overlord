{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "cache": {
    "useCache": true,
    "cacheLocation": ".cspellcache"
  },
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "reports/**",
    "package-lock.json",
    "test/fixtures/**",
    "src/core/knobs/catalog.generated.json"
  ],
  "dictionaries": ["typescript", "node", "softwareTerms", "npm", "bash", "html", "css"],
  "words": [
    "anthropic",
    "automem",
    "clangd",
    "cowork",
    "depcruise",
    "dont",
    "echarts",
    "edutools",
    "fastcheck",
    "frontmatter",
    "gantt",
    "growthbook",
    "jsonl",
    "knip",
    "lefthook",
    "mcpservers",
    "mdlint",
    "nodash",
    "oauth",
    "otel",
    "otlp",
    "overlord",
    "panter",
    "picomatch",
    "pyright",
    "repoints",
    "shanep",
    "sonarjs",
    "sparklines",
    "statusline",
    "stryker",
    "subagent",
    "subagents",
    "teleport",
    "traceparent",
    "treemap",
    "tsconfig",
    "ttft",
    "upserted",
    "vsix",
    "worktree",
    "worktrees"
  ]
}
