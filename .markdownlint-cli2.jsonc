{
  "config": {
    "default": true,
    // Long table rows and URLs are normal in docs.
    "MD013": false,
    // Allow the same heading text under different parents.
    "MD024": { "siblings_only": true },
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "dist/**", "coverage/**", "reports/**", "CHANGELOG.md"],
}
