{
  "name": "overlord",
  "displayName": "Overlord",
  "description": "htop for Claude Code: watch, tune and run many Claude Code agents from VS Code.",
  "version": "0.1.0",
  "publisher": "shanep",
  "license": "MIT",
  "author": "Shane Panter",
  "repository": {
    "type": "git",
    "url": "https://github.com/shanep/overlord.git"
  },
  "engines": {
    "vscode": "^1.140.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "agents",
    "monitor"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [],
    "viewsContainers": {},
    "views": {},
    "configuration": {}
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:integration": "node scripts/build.mjs && vscode-test",
    "type-coverage": "type-coverage --strict --at-least 100 --detail -p tsconfig.json",
    "knip": "knip",
    "depcruise": "depcruise src webview --config .dependency-cruiser.cjs",
    "spell": "cspell --no-progress --gitignore \"**/*.{ts,tsx,md,json,mjs,cjs}\"",
    "mdlint": "markdownlint-cli2",
    "nodash": "node scripts/check-no-dashes.mjs",
    "catalog": "node scripts/generate-catalog.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run type-coverage && npm run knip && npm run depcruise && npm run spell && npm run mdlint && npm run nodash",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "echarts": "^6.1.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/strictest": "^2.0.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "axe-core": "^4.14.0",
    "cspell": "^10.4.0",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.23.3",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "type-coverage": "^2.30.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
